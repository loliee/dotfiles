#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset

# HOMEBREW options
export HOMEBREW_CASK_OPTS="--appdir=${HOME}/Applications --fontdir=${HOME}/Library/Fonts --require-sha"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSECURE_REDIRECT=1
export HOMEBREW_NO_BOTTLE_SOURCE_FALLBACK=1
# Homebrew installs gh unchecked, as gh is what checks the others (Library/Homebrew/attestation.rb)
export HOMEBREW_VERIFY_ATTESTATIONS=1
: "${HOMEBREW_GITHUB_API_TOKEN:?export a read-only GitHub token first, see README.md}"
export PATH="/opt/homebrew/bin:${PATH}"

# Homebrew and git need the Command Line Tools; their installer runs on its own, outside this script
if ! xcode-select -p &>/dev/null; then
  echo '--> Installing the Command Line Tools: run this script again once they are installed'
  xcode-select --install
  exit 1
fi

# Not under ~: bottles only relocate to a prefix no longer than /opt/homebrew
if [[ ! -f /opt/homebrew/bin/brew ]]; then
  echo '--> Installing homebrew...'
  sudo mkdir -p /opt/homebrew &&
    sudo chown "${USER}:admin" /opt/homebrew &&
    chmod 0700 /opt/homebrew &&
    git clone https://github.com/Homebrew/brew /opt/homebrew
fi

trap 'brew cleanup' INT TERM HUP EXIT

echo "--> Make sure we're using the latest Homebrew"
brew update

echo '--> Upgrade any already-installed formulae'
brew upgrade

# Arguments such as --force go to brew install; ${1+"$@"} because macOS's bash 3.2 fails nounset on an empty "$@"
brew install ${1+"$@"} \
  ansifilter \
  awscli \
  bash \
  bash-completion@2 \
  bat \
  claude \
  claude-code \
  closure-compiler \
  colima \
  coredns \
  coreutils \
  curl \
  diff-so-fancy \
  direnv \
  dive \
  docker \
  docker-buildx \
  docker-compose \
  fd \
  findutils \
  firefox \
  fish \
  font-iosevka-nerd-font \
  fzf \
  gawk \
  gh \
  ghostty \
  git \
  git-absorb \
  git-filter-repo \
  git-lfs \
  glab \
  gnu-sed \
  gnu-tar \
  gnu-time \
  gnu-which \
  gnupg \
  grep \
  ipcalc \
  k9s \
  kubectx \
  languagetool \
  lima \
  luacheck \
  mise \
  mistral-vibe \
  mkcert \
  moreutils \
  mozjpeg \
  neovim \
  openssh \
  openssl \
  pv \
  pwgen \
  reattach-to-user-namespace \
  rg \
  s5cmd \
  signal \
  skopeo \
  slack \
  starship \
  stow \
  the-unarchiver \
  tig \
  tmux \
  tor-browser \
  transmission \
  tree \
  tree-sitter \
  tree-sitter-cli \
  vlc \
  watch \
  wget \
  wireguard-tools \
  xz \
  zoxide

mkdir -p ~/.docker/cli-plugins
ln -sfn "$(brew --prefix)/opt/docker-compose/bin/docker-compose" ~/.docker/cli-plugins/docker-compose
ln -sfn "$(brew --prefix)/opt/docker-buildx/bin/docker-buildx" ~/.docker/cli-plugins/docker-buildx

# brew install fails on a Little Snitch installed outside Homebrew
if ! littlesnitch -v &>/dev/null; then
  brew install ${1+"$@"} --appdir /Applications \
    little-snitch \
    micro-snitch
fi

brew install ${1+"$@"} --appdir /Applications \
  1password \
  1password-cli \
  ollama-app

# Configure languagetool
brew services start languagetool

# Without a password root runs only root-owned code: /opt/homebrew and ~/.config belong to the user
echo "--> Setup opx-net-down, requires root permission!"
sudo install -d -o root -g wheel -m 0755 /usr/local/bin
sudo install -o root -g wheel -m 0755 "$(dirname "${BASH_SOURCE[0]}")/.opx-net-down" /usr/local/bin/opx-net-down
sudoers_rule="${USER} ALL=(root) NOPASSWD: /usr/local/bin/opx-net-down \"\""
if ! echo "${sudoers_rule}" | sudo cmp -s - "/etc/sudoers.d/${USER}"; then
  if sudo test -e "/etc/sudoers.d/${USER}"; then
    echo "--> Replacing /etc/sudoers.d/${USER}, which held:"
    sudo cat "/etc/sudoers.d/${USER}"
  fi
  # sudo skips sudoers.d files with a dot in their name, so the rule goes live only once visudo accepts it
  echo "${sudoers_rule}" | sudo tee "/etc/sudoers.d/${USER}.new" >/dev/null
  sudo chmod 0440 "/etc/sudoers.d/${USER}.new"
  sudo visudo -cqf "/etc/sudoers.d/${USER}.new"
  sudo mv "/etc/sudoers.d/${USER}.new" "/etc/sudoers.d/${USER}"
fi

# CoreDNS needs root for port 53, so root runs root-owned copies of its binary, Corefile and blocklist
echo "--> Setup CoreDNS on port 53, requires root permission!"
sudo install -d -o root -g wheel -m 0755 /usr/local/libexec /etc/coredns
sudo install -o root -g wheel -m 0755 "$(brew --prefix coredns)/bin/coredns" /usr/local/libexec/coredns
# A hosts list that names each subdomain, as CoreDNS hosts matches exact names; only 0.0.0.0 lines: it never redirects
curl --fail --silent --show-error --proto =https --tlsv1.2 \
  https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts |
  awk '$1 == "0.0.0.0" && $2 != "0.0.0.0" { print "0.0.0.0", $2 }' | sudo tee /etc/coredns/blocklist.hosts >/dev/null
sudo install -o root -g wheel -m 0644 "$(dirname "${BASH_SOURCE[0]}")/.coredns.plist" \
  /Library/LaunchDaemons/local.coredns.plist
if ! sudo test -e /etc/coredns/Corefile && [[ -f /opt/homebrew/etc/coredns/Corefile ]]; then
  sudo install -o root -g wheel -m 0644 /opt/homebrew/etc/coredns/Corefile /etc/coredns/Corefile
fi
if sudo test -e /etc/coredns/Corefile; then
  # bootstrap refuses a job already loaded, and bootout can return before launchd has removed it
  if sudo launchctl print system/local.coredns &>/dev/null; then
    sudo launchctl bootout system/local.coredns
    while sudo launchctl print system/local.coredns &>/dev/null; do
      sleep 0.1
    done
  fi
  sudo launchctl bootstrap system /Library/LaunchDaemons/local.coredns.plist
else
  echo "--> No Corefile: write /etc/coredns/Corefile with sudo -e, then run .brew again"
fi
