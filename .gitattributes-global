# Let Git detect text vs binary files and normalize text to LF.
* text=auto

# Explicitly binary files where Git's detection can be undesirable.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
