# SSHRC overrides

export EDITOR=vim
export VISUAL=vim

case "$(hostname)" in
  *-int-*|int-*|*-int)
    PATATETOY_USERNAME_COLOR=green
    ;;
  *-tst-*|tst-*|*-tst)
    PATATETOY_USERNAME_COLOR=blue
    ;;
  *-stg-*|stg-*|*-stg)
    PATATETOY_USERNAME_COLOR=yellow
    ;;
  *)
    PATATETOY_USERNAME_COLOR=red
    ;;
esac
export PATATETOY_USERNAME_COLOR

unalias vim
alias vi=vim
