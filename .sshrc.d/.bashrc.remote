# SSHRC overrides

export EDITOR=vim
export VISUAL=vim

case "$(hostname)" in
  *-int-*|int-*|*-int)
    THEME_COLOR=yellow
    ;;
  *-tst-*|tst-*|*-tst)
    THEME_COLOR=yellow
    ;;
  *-stg-*|stg-*|*-stg)
    THEME_COLOR=yellow
    ;;
  *)
    THEME_COLOR=magenta
    ;;
esac

PATATETOY_USERNAME_COLOR="${THEME_COLOR}"
export \
  THEME_COLOR \
  PATATETOY_USERNAME_COLOR

unalias vim
alias vi=vim
alias vims="sudo -E vim"

# Setup block cursor
printf '\e[2 q'
