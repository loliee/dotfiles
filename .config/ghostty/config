theme = patatetoy
title = " "
bell-features = no-title

fullscreen = non-native-padded-notch

font-family = "Iosevka Nerd Font"
font-size = 14
window-padding-x = 5
window-padding-y = 5

copy-on-select = clipboard

# ─────────────────────────────
# Keyboard Bindings
# ─────────────────────────────

keybind = ctrl+enter=reload_config
keybind = super+d=unbind
keybind = super+t=unbind

# Fast escape
keybind = cmd+j=text:\x1B

# ← ↓ ↑ →
keybind = ctrl+h=csi:D
keybind = ctrl+j=csi:B
keybind = ctrl+k=csi:A
keybind = ctrl+l=csi:C

# Vim: Ctrl-Alt-Shift F5 to F10, which no terminfo names and shells ignore
keybind = cmd+p=csi:15;8~
keybind = cmd+n=csi:17;8~
keybind = cmd+s=csi:18;8~
keybind = cmd+u=csi:19;8~
keybind = cmd+@=csi:20;8~
keybind = cmd+digit_1=csi:21;8~

# Tmux
keybind = cmd+f=csi:9999~

# Beginning / end of line
keybind = alt+h=text:^
keybind = alt+l=text:$
