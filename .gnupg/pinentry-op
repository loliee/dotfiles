#!/usr/bin/env bash
#
# Pinentry for gpg-agent: answers with the GPG subkeys passphrase from 1Password, refuses everything else.
# op signout after each read makes 1Password ask Touch ID every time, as its SSH agent does.
set -euo pipefail

readonly OP=/opt/homebrew/bin/op
# Always given: with several accounts, op has no terminal to ask which; gpg forwards PINENTRY_USER_DATA per request
readonly ACCOUNT="${PINENTRY_USER_DATA:-my.1password.com}"
# Looked up by name: a business account names its personal vault Employee, not Private
readonly ITEM='GPG subkeys'
# GPG_ERR_CANCELED from source pinentry: gpg reports "Operation cancelled"
readonly CANCELLED='ERR 83886179 Operation cancelled <Pinentry>'

read_passphrase() {
  local passphrase
  "${OP}" whoami --account "${ACCOUNT}" >/dev/null 2>&1 ||
    "${OP}" signin --account "${ACCOUNT}" >/dev/null 2>&1 || return 1
  passphrase="$("${OP}" item get "${ITEM}" --account "${ACCOUNT}" --fields label=password --reveal)" || return 1
  "${OP}" signout --account "${ACCOUNT}" >/dev/null 2>&1 || true
  printf '%s' "${passphrase}"
}

# Assuan data lines must percent-escape %, CR and LF
escape() {
  local s="$1"
  s="${s//\%/%25}"
  s="${s//$'\r'/%0D}"
  s="${s//$'\n'/%0A}"
  printf '%s' "${s}"
}

main() {
  local line passphrase refuse=false
  echo 'OK Pleased to meet you'
  while IFS= read -r line; do
    case "${line}" in
      # A new passphrase or a retry after a wrong one: never answered from 1Password
      SETREPEAT* | SETERROR*)
        refuse=true
        echo OK
        ;;
      GETPIN)
        if [[ ${refuse} == false ]] && passphrase="$(read_passphrase)"; then
          printf 'D %s\nOK\n' "$(escape "${passphrase}")"
        else
          echo "${CANCELLED}"
        fi
        ;;
      CONFIRM*) echo "${CANCELLED}" ;;
      BYE)
        echo 'OK closing connection'
        return 0
        ;;
      *) echo OK ;;
    esac
  done
}

main "$@"
