{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "filesystem": {
      "allowRead": ["/[my_project]"],
      "allowWrite": ["/[my_project]"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)"
    ],
    "ask": ["Bash(*)"]
  }
}
