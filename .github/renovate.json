{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["github-actions", "mise", "pre-commit"],
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Repo mise.toml, in one PR as its tools share mise.lock",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "groupName": "repo mise tools"
    },
    {
      "description": "Home config: the script locks it as global, as in the clone mise.toml shadows shared tools",
      "matchManagers": ["mise"],
      "matchFileNames": [".config/mise/config.toml"],
      "groupName": "home mise tools",
      "skipArtifactsUpdate": true,
      "postUpgradeTasks": {
        "commands": [".github/scripts/mise-lock-home {{{depName}}}"],
        "fileFilters": [".config/mise/mise.lock", ".config/mise/locks/**"],
        "installTools": { "mise": {} }
      }
    },
    {
      "description": "Python stays on 3.14 until pyyaml ships cp315 wheels: https://github.com/yaml/pyyaml/issues/951",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "description": "imgpkg skips 0.49.1, a tag with no release or binaries: https://github.com/carvel-dev/imgpkg/releases",
      "matchManagers": ["mise"],
      "matchDepNames": ["imgpkg"],
      "allowedVersions": "!/^0\\.49\\.1$/"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
