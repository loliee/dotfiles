{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["github-actions", "mise", "pre-commit"],
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Repo mise.toml, in one PR as its tools share mise.lock",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "groupName": "repo mise tools"
    },
    {
      "description": "Home config: the script locks it as global, as in the clone mise.toml shadows shared tools",
      "matchManagers": ["mise"],
      "matchFileNames": [".config/mise/config.toml"],
      "groupName": "home mise tools",
      "skipArtifactsUpdate": true,
      "postUpgradeTasks": {
        "commands": [".github/scripts/mise-lock-home {{{depName}}}"],
        "fileFilters": [".config/mise/mise.lock", ".config/mise/locks/**"],
        "installTools": { "mise": {} }
      }
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
